{
  "name": "rss-puzzle",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "cross-env NODE_ENV=development webpack  serve --mode development",
    "build-dev": "cross-env NODE_ENV=development webpack --mode development",
    "build-prod": "cross-env NODE_ENV=production webpack --mode production",
    "clear": "rd /s /q build",
    "format": "prettier --write .",
    "ci:format": "prettier --check .",
    "lint": "eslint . --ext .ts",
    "lintfix": "eslint . --ext .ts --fix",
    "predeploy": "npm run build-prod",
    "deploy": "npm run build-prod && npx gh-pages -d build -e rss-puzzle",
    "prepare": "cd .. && husky install"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "pre-push": "npm run lint && npx validate-branch-name"
    }
  },
  "lint-staged": {
    "**/*": [
      "prettier --write .",
      "git add"
    ]
  },
  "validate-branch-name": {
    "pattern": "^(feat|fix|refactor)/RSS-PZ((-\\d{2,3})?)\\_[A-Za-z]+$",
    "errorMsg": "your own error message"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "homepage": "https://rolling-scopes-school.github.io/aliquickc-JSFE2023Q4/rss-puzzle/",
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "clean-webpack-plugin": "^4.0.0",
    "copy-webpack-plugin": "^12.0.2",
    "cross-env": "^7.0.3",
    "css-loader": "^6.10.0",
    "eslint": "^8.57.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-airbnb-typescript": "^18.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-webpack-plugin": "^4.0.1",
    "gh-pages": "^6.1.1",
    "html-loader": "^5.0.0",
    "html-webpack-plugin": "^5.6.0",
    "husky": "^8.0.0",
    "lint-staged": "^15.2.2",
    "mini-css-extract-plugin": "^2.8.1",
    "node-sass": "^9.0.0",
    "postcss-loader": "^8.1.1",
    "postcss-preset-env": "^9.4.0",
    "prettier": "^3.2.5",
    "sass-loader": "^14.1.1",
    "ts-loader": "^9.5.1",
    "typescript": "^5.3.3",
    "validate-branch-name": "^1.3.0",
    "webpack": "^5.90.3",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.0.2"
  },
  "dependencies": {}
}
